	local hue = 0
	local rainbowOn = false
	rainbowBtn.MouseButton1Click:Connect(function()
		rainbowOn = not rainbowOn
		if rainbowOn then
			task.spawn(function()
				while rainbowOn and preview.Parent do
					hue = (hue + 0.01) % 1
					cur = Color3.fromHSV(hue, 0.85, 1)
					preview.BackgroundColor3 = cur
					if config.Callback then pcall(config.Callback, cur) end
					task.wait(0.03)
				end
			end)
		end
	end)

	local api = {}
	function api:Set(c) cur = c preview.BackgroundColor3 = c end
	function api:Get() return cur end
	return api
end

return LunUI

