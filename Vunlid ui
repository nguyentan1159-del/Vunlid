	btn.Text = ""
	btn.BackgroundColor3 = self.Theme.Background
	btn.Size = UDim2.new(1, -130, 0, 28)
	btn.Position = UDim2.new(0, 125, 0.5, -14)
	btn.AutoButtonColor = false
	btn.Parent = base
	Corner(btn, 7)
	Stroke(btn, self.Theme.Stroke, 1)
	AddShine(btn, false)

	local btnLbl = Instance.new("TextLabel")
	btnLbl.Text = #selected > 0 and table.concat(selected, ", ") or "Chọn..."
	btnLbl.Font = Enum.Font.Gotham
	btnLbl.TextSize = 12
	btnLbl.TextColor3 = self.Theme.TextDim
	btnLbl.TextXAlignment = Enum.TextXAlignment.Left
	btnLbl.BackgroundTransparency = 1
	btnLbl.Size = UDim2.new(1, -28, 1, 0)
	btnLbl.Position = UDim2.new(0, 8, 0, 0)
	btnLbl.Parent = btn
	local arrow = Instance.new("TextLabel")
	arrow.Text = "▾"
	arrow.Font = Enum.Font.GothamBold
	arrow.TextSize = 14
	arrow.TextColor3 = self.Theme.Accent2
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.new(0, 20, 1, 0)
	arrow.Position = UDim2.new(1, -22, 0, 0)
	arrow.Parent = btn

	local listFrame = Instance.new("Frame")
	listFrame.BackgroundColor3 = self.Theme.Background
	listFrame.Size = UDim2.new(1, 0, 0, 0)
	listFrame.Visible = false
	listFrame.ClipsDescendants = true
	listFrame.Parent = base
	Corner(listFrame, 8)
	Stroke(listFrame, self.Theme.Stroke, 1)
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 2)
	listLayout.Parent = listFrame
	Padding(listFrame, 4, 4, 4, 4)

	local function RefreshList()
		for _, ch in ipairs(listFrame:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
		for _, opt in ipairs(options) do
			local ob = Instance.new("TextButton")
			ob.Text = ""
			ob.BackgroundColor3 = self.Theme.Background3
			ob.Size = UDim2.new(1, 0, 0, 28)
			ob.AutoButtonColor = false
			ob.Parent = listFrame
			Corner(ob, 6)
			local ol = Instance.new("TextLabel")
			ol.Text = opt
			ol.Font = Enum.Font.Gotham
			ol.TextSize = 12
			ol.TextColor3 = self.Theme.Text
			ol.TextXAlignment = Enum.TextXAlignment.Left
			ol.BackgroundTransparency = 1
			ol.Size = UDim2.new(1, -30, 1, 0)
			ol.Position = UDim2.new(0, 8, 0, 0)
			ol.Parent = ob
			local check = Instance.new("TextLabel")
			check.Text = ""
			check.Font = Enum.Font.GothamBold
			check.TextSize = 12
			check.TextColor3 = self.Theme.Accent2
			check.BackgroundTransparency = 1
			check.Size = UDim2.new(0, 20, 1, 0)
			check.Position = UDim2.new(1, -22, 0, 0)
			check.Parent = ob
			local isSel = table.find(selected, opt) ~= nil
			if isSel then check.Text = "✓" ob.BackgroundColor3 = self.Theme.TabActive end
			ob.MouseEnter:Connect(function() Tween(ob, {BackgroundColor3 = self.Theme.TabActive}, 0.15) end)
			ob.MouseLeave:Connect(function() if not table.find(selected, opt) then Tween(ob, {BackgroundColor3 = self.Theme.Background3}, 0.15) end end)
			ob.MouseButton1Click:Connect(function()
				if multi then
					local idx = table.find(selected, opt)
					if idx then table.remove(selected, idx) else table.insert(selected, opt) end
					btnLbl.Text = #selected > 0 and table.concat(selected, ", ") or "Chọn..."
					if config.Callback then pcall(config.Callback, selected) end
					RefreshList()
				else
					selected = {opt}
					btnLbl.Text = opt
					btnLbl.TextColor3 = self.Theme.Text
					open = false
					listFrame.Visible = false
					Tween(arrow, {Rotation = 0}, 0.2)
					if config.Callback then pcall(config.Callback, opt) end
					RefreshList()
				end
			end)
		end
		-- cập nhật chiều cao list
		listFrame.Size = UDim2.new(1, 0, 0, math.min(#options * 30 + 8, 150))
	end
	RefreshList()

	btn.MouseButton1Click:Connect(function()
		open = not open
		listFrame.Visible = open
		Tween(arrow, {Rotation = open and 180 or 0}, 0.2)
		if open then
			base.Size = UDim2.new(1, 0, 0, 42 + listFrame.Size.Y.Offset + 8)
			listFrame.Position = UDim2.new(0, 0, 0, 46)
		else
			base.Size = UDim2.new(1, 0, 0, 42)
		end
	end)

	local api = {}
	function api:Set(v) if type(v)=="table" then selected=v else selected={v} end btnLbl.Text = table.concat(selected, ", ") RefreshList() end
	function api:Get() if multi then return selected else return selected[1] end end
	function api:SetOptions(newOpts) options = newOpts RefreshList() end
	return api
end

