--// Helper
local function Tween(obj, props, time, style, dir)
	local t = TweenService:Create(obj, TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end

local function Corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	c.Parent = parent
	return c
end

local function Stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Color3.fromRGB(45,45,65)
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function Padding(parent, top, bottom, left, right)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, top or 8)
	p.PaddingBottom = UDim.new(0, bottom or 8)
	p.PaddingLeft = UDim.new(0, left or 10)
	p.PaddingRight = UDim.new(0, right or 10)
	p.Parent = parent
	return p
end

--// Tia sáng quét qua (Shine Sweep)
--// Gắn vào bất kỳ Frame/Button nào. Tự chạy mỗi 2.5s hoặc khi hover
local function AddShine(parent, autoLoop)
	local clip = Instance.new("Frame")
	clip.Name = "ShineClip"
	clip.BackgroundTransparency = 1
	clip.ClipsDescendants = true
	clip.Size = UDim2.new(1, 0, 1, 0)
	clip.Position = UDim2.new(0, 0, 0, 0)
	clip.ZIndex = 5
	clip.Parent = parent

	local shine = Instance.new("Frame")
	shine.Name = "Shine"
	shine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	shine.BackgroundTransparency = 0.85
	shine.Size = UDim2.new(0, 45, 1, 0)
	shine.Position = UDim2.new(0, -60, 0, 0)
	shine.Rotation = 18
	shine.ZIndex = 5
	shine.Parent = clip

	local grad = Instance.new("UIGradient")
	grad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	grad.Parent = shine

	local function Sweep()
		shine.Position = UDim2.new(0, -60, 0, 0)
		Tween(shine, {Position = UDim2.new(1, 20, 0, 0)}, 0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	end

	if autoLoop then
		task.spawn(function()
			while clip.Parent do
				Sweep()
				task.wait(2.8)
			end
		end)
	end

	-- Hover cũng quét
	if parent:IsA("TextButton") or parent:IsA("ImageButton") then
		parent.MouseEnter:Connect(Sweep)
	end

	return Sweep
end

--// Viền chạy gradient (Animated Border)
local function AddAnimatedBorder(holder, colors, speed)
	local border = Instance.new("Frame")
	border.Name = "AnimatedBorder"
	border.AnchorPoint = Vector2.new(0.5, 0.5)
	border.Position = UDim2.new(0.5, 0, 0.5, 0)
	border.Size = UDim2.new(1, 6, 1, 6)
	border.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	border.ZIndex = 0
	border.Parent = holder
	Corner(border, 16)

	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, colors[1]),
		ColorSequenceKeypoint.new(0.33, colors[2]),
		ColorSequenceKeypoint.new(0.66, colors[3] or colors[1]),
		ColorSequenceKeypoint.new(1, colors[1]),
	})
	grad.Rotation = 0
	grad.Parent = border

	task.spawn(function()
		while border.Parent do
			local tw = TweenService:Create(grad, TweenInfo.new(speed or 3, Enum.EasingStyle.Linear), {Rotation = 360})
			tw:Play()
			tw.Completed:Wait()
			grad.Rotation = 0
		end
	end)
	return border
end

--// Ripple khi click
local function AddRipple(button)
	button.MouseButton1Click:Connect(function(x, y)
		-- lấy vị trí click tương đối
		local absPos = button.AbsolutePosition
		local absSize = button.AbsoluteSize
		local relX = 0
		local relY = 0
		pcall(function()
			local mouse = game:GetService("Players").LocalPlayer:GetMouse()
			relX = mouse.X - absPos.X
			relY = mouse.Y - absPos.Y
		end)
		local ripple = Instance.new("Frame")
		ripple.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		ripple.BackgroundTransparency = 0.7
		ripple.AnchorPoint = Vector2.new(0.5, 0.5)
		ripple.Position = UDim2.new(0, relX, 0, relY)
		ripple.Size = UDim2.new(0, 10, 0, 10)
		ripple.ZIndex = 6
		ripple.Parent = button
		Corner(ripple, 100)
		local target = math.max(absSize.X, absSize.Y) * 1.6
		Tween(ripple, {Size = UDim2.new(0, target, 0, target), BackgroundTransparency = 1}, 0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		game:GetService("Debris"):AddItem(ripple, 0.6)
	end)
end

--// Drag Window
local function MakeDraggable(dragArea, mainFrame)
	local dragging = false
	local dragInput, dragStart, startPos
	dragArea.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = mainFrame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	dragArea.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
end

