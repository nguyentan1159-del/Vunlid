			for _, t in pairs(Window.Tabs) do
				t.Page.Visible = false
				Tween(t.Button, {BackgroundColor3 = Theme.Background3}, 0.2)
				-- reset label color
				for _, ch in ipairs(t.Button:GetChildren()) do
