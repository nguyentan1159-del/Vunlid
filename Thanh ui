local function Viewport()
  local cam = workspace.CurrentCamera
  return cam and cam.ViewportSize or Vector2.new(1280, 720)
end

local function New(class, props, parent)
  local o = Instance.new(class)
  for k, v in pairs(props or {}) do o[k] = v end
  o.Parent = parent
  return o
end

local function Corner(o, r) return New("UICorner", {CornerRadius = UDim.new(0, r or 10)}, o) end

local function Stroke(o, color, thick, trans)
  return New("UIStroke", {Color = color, Thickness = thick or 1, Transparency = trans or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
end

local function Tween(o, props, dur, style)
  local t = TweenService:Create(o, TweenInfo.new(dur or 0.22, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
  t:Play()
  return t
end

local function Ripple(btn, x, y)
  local r = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.5, BorderSizePixel = 0, ZIndex = 99}, btn)
  Corner(r, 999)
  local s = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.2
  Tween(r, {Size = UDim2.fromOffset(s, s), BackgroundTransparency = 1}, 0.5)
  task.delay(0.5, function() if r then r:Destroy() end end)
end

local function MakeIcon(parent, id, x, y, size, color, zindex)
  return New("ImageLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(size, size), Image = "rbxassetid://" .. tostring(id), ImageColor3 = color or Color3.new(1, 1, 1), ScaleType = Enum.ScaleType.Fit, ZIndex = zindex or 6}, parent)
end

local function AddShine(parent, speed)
  local clip = New("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true, ZIndex = 5}, parent)
  local beam = New("Frame", {BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.85, Size = UDim2.new(0.35, 0, 1.6, 0), Position = UDim2.new(-0.4, 0, -0.3, 0), Rotation = 18, BorderSizePixel = 0}, clip)
  New("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.55), NumberSequenceKeypoint.new(1, 1)})}, beam)
  task.spawn(function()
    while clip:IsDescendantOf(game) do
      beam.Position = UDim2.new(-0.4, 0, -0.3, 0)
      Tween(beam, {Position = UDim2.new(1.2, 0, -0.3, 0)}, speed or 2.2, Enum.EasingStyle.Sine)
      task.wait((speed or 2.2) + 1.2)
    end
  end)
  return clip
end

function Thanh:CreateWindow(opts)
  opts = opts or {}

  -- ===== HUỶ INSTANCE CŨ KHI CHẠY LẠI SCRIPT =====
  local env = (getgenv and getgenv()) or _G
  if env.ThanhWindow then pcall(function() env.ThanhWindow:Destroy() end) end

  local alive = true
  local Conns = {}
  local function Track(c) table.insert(Conns, c) return c end

  -- ===== CONFIG =====
  local DEFAULT = {
    Theme = "Thanh", Language = "Tiếng Việt", Transparency = 8, Corner = 16,
    Meteor = true, Particles = true, Shine = true, Beam = true, Blur = true,
    EffectSpeed = 100, MeteorDensity = 100, Notifications = true, AutoSave = true,
    Keybind = "RightShift",
  }
  local Window = {Tabs = {}, TabList = {}, CurrentTab = nil, Open = true, NotificationsEnabled = true, Compact = false}
  Window.Config = {}
  for k, v in pairs(DEFAULT) do Window.Config[k] = v end
  if opts.Theme then Window.Config.Theme = opts.Theme end
  if opts.Language then Window.Config.Language = opts.Language end
  if opts.Keybind then Window.Config.Keybind = opts.Keybind.Name end

  do
    local ok, data = pcall(function()
      if isfile and readfile and isfile(CFG_FILE) then
        return HttpService:JSONDecode(readfile(CFG_FILE))
      end
    end)
    if ok and type(data) == "table" then
      for k, v in pairs(data) do Window.Config[k] = v end
    end
  end

  local CurLang = Window.Config.Language
  local T = THEMES[Window.Config.Theme] or THEMES.Thanh
  Window.Theme = T
  local Keybind = Enum.KeyCode[Window.Config.Keybind] or Enum.KeyCode.RightShift
  local EffectSpeed = Window.Config.EffectSpeed / 100
  local MeteorDensity = Window.Config.MeteorDensity / 100
  local Capturing = false
  local StartTime = tick()

  local function Bounds()
    local vp = Viewport()
    local minW, minH = math.min(MIN_W, vp.X - 8), math.min(MIN_H, vp.Y - 8)
    local maxW = math.max(minW, math.min(MAX_W, vp.X - 8))
    local maxH = math.max(minH, math.min(MAX_H, vp.Y - 8))
    return minW, minH, maxW, maxH
  end
  local function Fit(w, h)
    local a, b, c, d = Bounds()
    return math.clamp(w, a, c), math.clamp(h, b, d)
  end
  local WW, WH = Fit(opts.Width or 720, opts.Height or 470)
  local curW, curH = WW, WH

  -- ===== NGÔN NGỮ & THEME (hook có tự dọn khi object bị huỷ) =====
  local function L(s)
    if CurLang == "English" then return EN[s] or s end
    return s
  end
  local LangHooks, ThemeHooks = {}, {}
  local Gui
  local function Prune(list)
    for i = #list, 1, -1 do
      if not list[i].a:IsDescendantOf(Gui) then table.remove(list, i) end
    end
  end
  local function Bind(list, anchor, fn)
    table.insert(list, {a = anchor, f = fn})
    fn()
  end
  local function Loc(obj, prop, src)
    Bind(LangHooks, obj, function() obj[prop] = L(src) end)
    return obj
  end
  local function OnLang(anchor, fn) Bind(LangHooks, anchor, fn) end
  local function Themed(obj, prop, key)
    Bind(ThemeHooks, obj, function() obj[prop] = T[key] end)
    return obj
  end
  local function RefreshLang()
    Prune(LangHooks)
    for _, h in ipairs(LangHooks) do h.f() end
  end
