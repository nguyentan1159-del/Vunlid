			line.Size = UDim2.new(1, 0, 0, 1)
			line.BackgroundColor3 = Theme.Stroke
			line.BorderSizePixel = 0
			line.Parent = sec

			local container = Instance.new("Frame")
			container.BackgroundTransparency = 1
			container.Size = UDim2.new(1, 0, 0, 0)
			container.AutomaticSize = Enum.AutomaticSize.Y
			container.Parent = sec
			local cl = Instance.new("UIListLayout")
			cl.Padding = UDim.new(0, 7)
			cl.SortOrder = Enum.SortOrder.LayoutOrder
			cl.Parent = container

			local Section = {}
			Section.Frame = sec
			Section.Container = container

			-- Helper tạo base cho element
			local function BaseElement(height)
				local f = Instance.new("Frame")
				f.BackgroundColor3 = Theme.Background3
				f.Size = UDim2.new(1, 0, 0, height or 42)
				f.Parent = container
				Corner(f, 9)
				Stroke(f, Theme.Stroke, 1)
				Padding(f, 6, 6, 10, 10)
				return f
			end
			Section._Base = BaseElement
			Section.Theme = Theme

			-- Import element methods vào Section
			for k, v in pairs(LunUI.ElementMethods) do
				Section[k] = v
			end
			-- gán container vào Section để methods dùng
			Section._Container = container

			return Section
		end

		-- Cho phép Add trực tiếp vào Tab mà không cần Section
		function Tab:AddButton(...) local s = self:CreateSection("General") return s:AddButton(...) end

		return Tab
	end

	return Window
end

