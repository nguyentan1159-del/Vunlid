local function New(class, props, parent)
  local o = Instance.new(class)
  for k, v in pairs(props or {}) do o[k] = v end
  o.Parent = parent
  return o
end
local function Corner(o, r) return New("UICorner", {CornerRadius = UDim.new(0, r or 10)}, o) end
local function Stroke(o, color, thick, trans)
  return New("UIStroke", {Color = color, Thickness = thick or 1, Transparency = trans or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
end
local function Tween(o, props, dur, style)
  local t = TweenService:Create(o, TweenInfo.new(dur or 0.22, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props)
  t:Play() return t
end
local function Ripple(btn, x, y)
  local r = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(0, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.5, BorderSizePixel = 0, ZIndex = 99}, btn)
  Corner(r, 999)
  local s = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.2
  Tween(r, {Size = UDim2.fromOffset(s, s), BackgroundTransparency = 1}, 0.5)
  task.delay(0.5, function() r:Destroy() end)
end
local function MakeIcon(parent, id, x, y, size, color, zindex)
  return New("ImageLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(size, size), Image = "rbxassetid://" .. tostring(id), ImageColor3 = color or Color3.new(1, 1, 1), ScaleType = Enum.ScaleType.Fit, ZIndex = zindex or 6}, parent)
end
local function AddShine(parent, speed)
  local clip = New("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true, ZIndex = 5}, parent)
  local beam = New("Frame", {BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.85, Size = UDim2.new(0.35, 0, 1.6, 0), Position = UDim2.new(-0.4, 0, -0.3, 0), Rotation = 18, BorderSizePixel = 0}, clip)
  New("UIGradient", {Rotation = 90, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.55), NumberSequenceKeypoint.new(1, 1)})}, beam)
  task.spawn(function()
    while clip.Parent do
      beam.Position = UDim2.new(-0.4, 0, -0.3, 0)
      Tween(beam, {Position = UDim2.new(1.2, 0, -0.3, 0)}, speed or 2.2, Enum.EasingStyle.Sine)
      task.wait((speed or 2.2) + 1.2)
    end
  end)
  return clip
end

function Thanh:CreateWindow(opts)
  opts = opts or {}
  local T = THEMES[opts.Theme] or THEMES.Thanh
  local WW, WH = opts.Width or 720, opts.Height or 470
  local curW, curH = WW, WH
  local EffectSpeed = 1
  local MeteorDensity = 1
  local StartTime = tick()

  for _, v in ipairs(PlayerGui:GetChildren()) do
    if v:IsA("ScreenGui") and v.Name == "ThanhUI" then v:Destroy() end
  end

  local Gui = New("ScreenGui", {Name = "ThanhUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, PlayerGui)
  local Blur = New("BlurEffect", {Size = 18, Enabled = true}, game:GetService("Lighting"))

  local Root = New("Frame", {Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(WW, WH), BackgroundTransparency = 1}, Gui)
  local Content = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(WW, WH), BackgroundTransparency = 1}, Root)
  local ContentCorner = Corner(Content, 16)

  for i = 5, 1, -1 do
    local sh = New("Frame", {Position = UDim2.fromOffset(-i * 4, i * 2), Size = UDim2.new(1, i * 8, 1, i * 8), BackgroundColor3 = Color3.new(), BackgroundTransparency = 0.94, BorderSizePixel = 0, ZIndex = 0}, Content)
    Corner(sh, 10 + i * 2)
  end

  local Surface = New("CanvasGroup", {Size = UDim2.fromOffset(WW, WH), BackgroundColor3 = T.Bg, BackgroundTransparency = 0.08, BorderSizePixel = 0, ClipsDescendants = true}, Content)
  local SurfaceCorner = Corner(Surface, 16)
  Stroke(Surface, T.Line, 1, 0)
  local BgGrad = New("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = 0}, Surface)
  New("UIGradient", {Rotation = 135, Color = ColorSequence.new({ColorSequenceKeypoint.new(0, T.Accent), ColorSequenceKeypoint.new(0.4, T.Bg), ColorSequenceKeypoint.new(1, Color3.fromRGB(3, 8, 22))})}, BgGrad)

  -- Viền chuyển động
  local BeamGroup = New("Frame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 20}, Content)
  Corner(BeamGroup, 16)
  local BeamGrads = {}
  for i, cfg in ipairs({{16, 0.85}, {8, 0.5}, {3, 0}}) do
    local layer = New("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1)}, BeamGroup)
    Corner(layer, 16)
    local st = Stroke(layer, T.Accent, cfg[1], cfg[2])
    local g = New("UIGradient", {Rotation = i * 40, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.28, 0.98), NumberSequenceKeypoint.new(0.42, 0.55), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(0.58, 0.55), NumberSequenceKeypoint.new(0.72, 0.98), NumberSequenceKeypoint.new(1, 1)})}, st)
    table.insert(BeamGrads, g)
  end

  -- Hạt nổi + Thiên thạch
  local ParticleLayer = New("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true, ZIndex = 1}, Surface)
  local MeteorLayer = New("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true, ZIndex = 2}, Surface)
  local Rnd = Random.new(tick())
  local Dots = {}
  for i = 1, 42 do
    local s = Rnd:NextNumber(2, 5)
    local d = New("Frame", {BorderSizePixel = 0, BackgroundColor3 = (i % 3 == 0) and T.Secondary or T.Accent, BackgroundTransparency = 0.3, Position = UDim2.fromScale(Rnd:NextNumber(), Rnd:NextNumber()), Size = UDim2.fromOffset(s, s), ZIndex = 1}, ParticleLayer)
    Corner(d, 99)
    table.insert(Dots, {obj = d, x = d.Position.X.Scale, y = d.Position.Y.Scale, sx = Rnd:NextNumber(-0.02, 0.02), sy = Rnd:NextNumber(-0.035, -0.01), ph = Rnd:NextNumber(0, 6.28), base = s})
  end
  local function SpawnMeteor()
    if not MeteorLayer.Parent then return end
    local len = Rnd:NextInteger(90, 210)
    local m = New("Frame", {BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.15, BorderSizePixel = 0, Size = UDim2.new(0, len, 0, 2), Position = UDim2.fromScale(Rnd:NextNumber(0.4, 1.1), -0.05), Rotation = 35, ZIndex = 2}, MeteorLayer)
    New("UIGradient", {Rotation = 0, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.15, 0.2), NumberSequenceKeypoint.new(1, 1)})}, m)
    local head = New("Frame", {AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(0, 2, 0.5, 0), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = T.Accent, BorderSizePixel = 0}, m)
    Corner(head, 99)
    Tween(m, {Position = UDim2.fromScale(m.Position.X.Scale - 0.7, 1.1)}, 1.1 / EffectSpeed, Enum.EasingStyle.Linear)
    task.delay(1.15 / EffectSpeed, function() m:Destroy() end)
  end
  task.spawn(function()
    while MeteorLayer.Parent do
      if MeteorLayer.Visible then SpawnMeteor() end
      task.wait(Rnd:NextNumber(0.35, 0.9) / (MeteorDensity * EffectSpeed))
    end
  end)

  -- Header
  local Header = New("Frame", {BackgroundTransparency = 1, Size = UDim2.fromOffset(WW, 72), ZIndex = 5, ClipsDescendants = true}, Surface)
  local HeaderShine = AddShine(Header, 2.6)
  local Title = New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(22, 10), Size = UDim2.fromOffset(400, 38), Font = Enum.Font.GothamBlack, TextSize = 30, Text = opts.Name or "THANH", TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6}, Header)
  New("UIGradient", {Rotation = 0, Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(0.4, T.Accent), ColorSequenceKeypoint.new(1, T.Secondary)})}, Title)
  New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 46), Size = UDim2.fromOffset(400, 18), Font = Enum.Font.Gotham, TextSize = 11, Text = opts.Subtitle or "THANH OPERATIONS", TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6}, Header)
  local Drag = New("Frame", {BackgroundTransparency = 1, Active = true, Size = UDim2.fromOffset(WW - 180, 72), ZIndex = 4}, Header)

  local function TopBtn(x, iconId, cb)
    local b = New("TextButton", {Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(x, 18), Size = UDim2.fromOffset(36, 36), BackgroundColor3 = T.Field, BackgroundTransparency = 0.4, BorderSizePixel = 0, ZIndex = 20}, Header)
    Corner(b, 10) Stroke(b, T.Line, 1, 0.3)
    MakeIcon(b, iconId, 9, 9, 18, T.Text, 21)
    b.MouseEnter:Connect(function() Tween(b, {BackgroundTransparency = 0.15}) end)
    b.MouseLeave:Connect(function() Tween(b, {BackgroundTransparency = 0.4}) end)
    b.Activated:Connect(function() Ripple(b, 18, 18) cb() end)
    return b
  end

  local Sidebar = New("Frame", {Position = UDim2.fromOffset(0, 72), Size = UDim2.fromOffset(158, WH - 72), BackgroundColor3 = T.Side, BackgroundTransparency = 0.25, BorderSizePixel = 0, ZIndex = 4}, Surface)
  local Body = New("ScrollingFrame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(174, 84), Size = UDim2.new(1, -190, 1, -100), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 5, ScrollBarImageColor3 = T.Accent, ZIndex = 3}, Surface)

  local Window = {Gui = Gui, Root = Root, Theme = T, Tabs = {}, CurrentTab = nil, Open = true, NotificationsEnabled = true, Compact = false}
  local TabButtons = {}
  local minBtn, closeBtn, settingsBtn
  local FpsLabel = nil

  Window.Config = {
    Theme = "Thanh", Transparency = 8, Corner = 16, Language = "Tiếng Việt",
    Meteor = true, Particles = true, Shine = true, Beam = true, Blur = true,
    EffectSpeed = 100, MeteorDensity = 100, Notifications = true, AutoSave = true,
    Keybind = "RightShift"
  }
  local function SaveConfig()
    local ok, json = pcall(function() return HttpService:JSONEncode(Window.Config) end)
    if ok then
      if writefile then pcall(function() writefile("Thanh_Config.json", json) end) end
      if Window.NotificationsEnabled then Window:Notify("THANH", "Đã lưu cấu hình!", 2) end
    end
  end
  local function MaybeSave() if Window.Config.AutoSave then SaveConfig() end end

  local function ApplyTheme(newT, name)
    T = newT Window.Theme = newT
    Surface.BackgroundColor3 = newT.Bg
    Sidebar.BackgroundColor3 = newT.Side
    for _, layer in ipairs(BeamGroup:GetChildren()) do
      for _, child in ipairs(layer:GetChildren()) do if child:IsA("UIStroke") then child.Color = newT.Accent end end
    end
    for _, p in ipairs(Dots) do p.obj.BackgroundColor3 = newT.Accent end
    if name then Window.Config.Theme = name MaybeSave() end
  end

  local function ApplySize(w, h)
    curW, curH = w, h
    Root.Size = UDim2.fromOffset(w, h) Content.Size = UDim2.fromOffset(w, h) Surface.Size = UDim2.fromOffset(w, h)
    Header.Size = UDim2.fromOffset(w, 72) Drag.Size = UDim2.fromOffset(w - 180, 72) Sidebar.Size = UDim2.fromOffset(158, h - 72)
    if settingsBtn then settingsBtn.Position = UDim2.fromOffset(w - 132, 18) end
    if minBtn then minBtn.Position = UDim2.fromOffset(w - 88, 18) end
    if closeBtn then closeBtn.Position = UDim2.fromOffset(w - 44, 18) end
  end

  -- Grip kéo giãn ở góc phải dưới
  local ResizeGrip = New("Frame", {AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -4, 1, -4), Size = UDim2.fromOffset(30, 30), BackgroundTransparency = 1, ZIndex = 30, Active = true}, Surface)
  for i = 1, 3 do
    New("Frame", {Position = UDim2.fromOffset(8 + i * 4, 18 - i * 1), Size = UDim2.fromOffset(16 - i * 3, 2), BackgroundColor3 = T.Muted, BackgroundTransparency = 0.15, BorderSizePixel = 0, Rotation = -45, ZIndex = 31}, ResizeGrip)
  end
  local GripHit = New("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 32}, ResizeGrip)
  local resizing = false local resizeStart, startSize
  GripHit.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then resizing = true resizeStart = Vector2.new(i.Position.X, i.Position.Y) startSize = Vector2.new(curW, curH) end
  end)
  UserInputService.InputChanged:Connect(function(i)
    if resizing and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
      local d = Vector2.new(i.Position.X, i.Position.Y) - resizeStart
      ApplySize(math.clamp(startSize.X + d.X, 520, 1100), math.clamp(startSize.Y + d.Y, 360, 800))
    end
  end)
  UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then resizing = false end end)

  local function SelectTab(tab)
    Window.CurrentTab = tab
    for _, t in pairs(Window.Tabs) do t.Frame.Visible = (t == tab) end
    for _, b in pairs(TabButtons) do
      local active = b.Tab == tab
      Tween(b.Btn, {BackgroundColor3 = active and T.Field or T.Side, BackgroundTransparency = active and 0.1 or 1})
      b.Label.TextColor3 = active and T.Text or T.Muted
      if b.Dot then b.Dot.BackgroundTransparency = active and 0 or 1 end
      if b.Icon then b.Icon.ImageColor3 = active and T.Accent or T.Muted end
    end
    Body.CanvasPosition = Vector2.new(0, 0)
  end

  function Window:CreateTab(name, iconId)
    local btn = New("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromOffset(142, 40), BorderSizePixel = 0}, Sidebar)
    Corner(btn, 9)
    local icon, dot local labelX = 28
    if iconId then icon = MakeIcon(btn, iconId, 10, 11, 18, T.Muted, 6) labelX = 34 else dot = New("Frame", {Position = UDim2.fromOffset(10, 16), Size = UDim2.fromOffset(8, 8), BackgroundColor3 = T.Accent, BackgroundTransparency = 1, BorderSizePixel = 0}, btn) Corner(dot, 99) end
    local lbl = New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(labelX, 0), Size = UDim2.new(1, -labelX - 4, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 14, Text = name, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left}, btn)
    local count = 0 for _ in pairs(Window.Tabs) do count += 1 end
    btn.Position = UDim2.fromOffset(8, 10 + count * 46)
    local frame = New("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false}, Body)
    local tab = {Name = name, Frame = frame, Y = 0}
    Window.Tabs[name] = tab TabButtons[name] = {Btn = btn, Label = lbl, Dot = dot, Icon = icon, Tab = tab}
    btn.Activated:Connect(function() SelectTab(tab) Ripple(btn, 70, 20) end)
    function tab:CreateSection(title)
      local card = New("Frame", {Position = UDim2.fromOffset(0, self.Y), Size = UDim2.new(1, -4, 0, 64), BackgroundColor3 = T.Card, BackgroundTransparency = 0.35, BorderSizePixel = 0, ClipsDescendants = true}, self.Frame)
      Corner(card, 12) Stroke(card, T.Line, 1, 0.35)
      New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 30), Font = Enum.Font.GothamBold, TextSize = 15, Text = title, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left}, card)
      New("Frame", {Position = UDim2.fromOffset(14, 44), Size = UDim2.new(1, -28, 0, 1), BackgroundColor3 = T.Line, BackgroundTransparency = 0.5, BorderSizePixel = 0}, card)
      local sec = {Card = card, Y = 54, ParentTab = self}
      function sec:Grow(h) self.Y += h card.Size = UDim2.new(1, -4, 0, self.Y + 10) self.ParentTab.Y += h + 8 end
      function sec:AddLabel(text)
        local lb = New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(14, self.Y), Size = UDim2.new(1, -28, 0, 28), Font = Enum.Font.Gotham, TextSize = 12, Text = text, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true}, card)
        self:Grow(32)
        return {Label = lb, Set = function(_, v) lb.Text = v end}
      end
      function sec:AddToggle(cfg)
        local row = New("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(14, self.Y), Size = UDim2.new(1, -28, 0, 48)}, card)
        New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, -70, 0, 26), Font = Enum.Font.GothamMedium, TextSize = 13, Text = cfg.Name, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left}, row)
        if cfg.Desc then New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 24), Size = UDim2.new(1, -70, 0, 20), Font = Enum.Font.Gotham, TextSize = 11, Text = cfg.Desc, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left}, row) end
        local v = cfg.Default or false
        local btn = New("TextButton", {Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 8), Size = UDim2.fromOffset(52, 28), BackgroundColor3 = v and T.Accent or T.Field, BorderSizePixel = 0}, row)
        Corner(btn, 99) Stroke(btn, v and T.Accent or T.Muted, 1, 0.4)
        local knob = New("Frame", {Position = UDim2.fromOffset(v and 26 or 3, 3), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0}, btn) Corner(knob, 99)
        btn.Activated:Connect(function() v = not v Tween(btn, {BackgroundColor3 = v and T.Accent or T.Field}) Tween(knob, {Position = UDim2.fromOffset(v and 26 or 3, 3)}) Ripple(btn, 26, 14) if cfg.Callback then cfg.Callback(v) end end)
        self:Grow(52)
      end
      function sec:AddSlider(cfg)
        local row = New("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(14, self.Y), Size = UDim2.new(1, -28, 0, 56)}, card)
        local valLbl = New("TextLabel", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(80, 24), Font = Enum.Font.GothamBold, TextSize = 13, Text = tostring(cfg.Default or cfg.Min), TextColor3 = T.Accent, TextXAlignment = Enum.TextXAlignment.Right}, row)
        New("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, -80, 0, 24), Font = Enum.Font.GothamMedium, TextSize = 13, Text = cfg.Name, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left}, row)
        local track = New("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 22)}, row)
        local bar = New("Frame", {Position = UDim2.fromOffset(0, 7), Size = UDim2.new(1, 0, 0, 8), BackgroundColor3 = T.Line, BackgroundTransparency = 0.4, BorderSizePixel = 0}, track) Corner(bar, 4)
        local cur = cfg.Default or cfg.Min
        local fill = New("Frame", {Size = UDim2.fromScale(math.clamp((cur - cfg.Min) / (cfg.Max - cfg.Min), 0, 1), 1), BackgroundColor3 = T.Accent, BorderSizePixel = 0}, bar) Corner(fill, 4)
        local knob = New("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(math.clamp((cur - cfg.Min) / (cfg.Max - cfg.Min), 0, 1), 0.5), Size = UDim2.fromOffset(20, 20), BackgroundColor3 = T.Accent, BorderSizePixel = 0}, bar) Corner(knob, 99)
        local dragging = false
        local function SetFromX(x)
          local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
          cur = math.floor(cfg.Min + a * (cfg.Max - cfg.Min) + 0.5)
          fill.Size = UDim2.fromScale(a, 1) knob.Position = UDim2.fromScale(a, 0.5) valLbl.Text = tostring(cur)
          if cfg.Callback then cfg.Callback(cur) end
        end
        track.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true SetFromX(i.Position.X) end end)
        UserInputService.InputChanged:Connect(function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then SetFromX(i.Position.X) end end)
        UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
        self:Grow(60)
      end
      function sec:AddButton(cfg)
        local btn = New("TextButton", {Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(14, self.Y), Size = UDim2.new(1, -28, 0, 44), BackgroundColor3 = T.Field, BackgroundTransparency = 0.35, BorderSizePixel = 0, ClipsDescendants = true}, card)
        Corner(btn, 9) Stroke(btn, T.Line, 1, 0.3) AddShine(btn, 1.8)
        New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 13, Text = cfg.Name, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6}, btn)
        btn.Activated:Connect(function() Ripple(btn, btn.AbsoluteSize.X / 2, 22) if cfg.Callback then cfg.Callback() end end)
        self:Grow(48)
      end
      function sec:AddDropdown(cfg)
        local row = New("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(14, self.Y), Size = UDim2.new(1, -28, 0, 44)}, card)
        New("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, -150, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 13, Text = cfg.Name, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left}, row)
        local btn = New("TextButton", {Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 2), Size = UDim2.fromOffset(140, 40), BackgroundColor3 = T.Field, BackgroundTransparency = 0.4, BorderSizePixel = 0, ClipsDescendants = true}, row)
        Corner(btn, 8) Stroke(btn, T.Line, 1, 0.3)
        local lbl = New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -36, 1, 0), Font = Enum.Font.Gotham, TextSize = 12, Text = cfg.Options[1] or "", TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left}, btn)
        MakeIcon(btn, ICONS.Chevron, 112, 11, 18, T.Muted, 6)
        local open = false
        local list = New("Frame", {Position = UDim2.fromOffset(14, self.Y + 48), Size = UDim2.new(1, -28, 0, 0), BackgroundColor3 = T.Field, BackgroundTransparency = 0.05, BorderSizePixel = 0, ClipsDescendants = true, Visible = false, ZIndex = 20}, card)
        Corner(list, 8) Stroke(list, T.Accent, 1.5, 0)
        btn.Activated:Connect(function()
          open = not open list.Visible = open Tween(list, {Size = UDim2.new(1, -28, 0, open and (#cfg.Options * 34 + 8) or 0)}, 0.2)
          if open then
            for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
            for i, opt in ipairs(cfg.Options) do
              local ob = New("TextButton", {Text = opt, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, BackgroundTransparency = 1, Position = UDim2.fromOffset(6, 4 + (i - 1) * 34), Size = UDim2.new(1, -12, 0, 30)}, list) Corner(ob, 6)
              ob.Activated:Connect(function() lbl.Text = opt open = false list.Visible = false if cfg.Callback then cfg.Callback(opt) end end)
            end
          end
        end)
        self:Grow(48)
      end
      function sec:AddTextbox(cfg)
        local row = New("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(14, self.Y), Size = UDim2.new(1, -28, 0, 44)}, card)
        New("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, -150, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 13, Text = cfg.Name, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left}, row)
        local box = New("TextBox", {PlaceholderText = cfg.Placeholder or "Nhập...", Text = "", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = T.Text, PlaceholderColor3 = T.Muted, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 2), Size = UDim2.fromOffset(150, 40), BackgroundColor3 = T.Field, BackgroundTransparency = 0.3, BorderSizePixel = 0, ClearTextOnFocus = false}, row)
        Corner(box, 8) Stroke(box, T.Line, 1, 0.3)
        box.FocusLost:Connect(function(enter) if enter and cfg.Callback then cfg.Callback(box.Text) end end)
        self:Grow(48)
      end
      function sec:AddKeybind(cfg)
        local row = New("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(14, self.Y), Size = UDim2.new(1, -28, 0, 44)}, card)
        New("TextLabel", {BackgroundTransparency = 1, Size = UDim2.new(1, -150, 1, 0), Font = Enum.Font.GothamMedium, TextSize = 13, Text = cfg.Name, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left}, row)
        local key = cfg.Default or Enum.KeyCode.E
        local btn = New("TextButton", {Text = key.Name, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = T.Text, AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 2), Size = UDim2.fromOffset(110, 40), BackgroundColor3 = T.Field, BackgroundTransparency = 0.3, BorderSizePixel = 0}, row)
        Corner(btn, 8) Stroke(btn, T.Line, 1, 0.3)
        local waiting = false
        btn.Activated:Connect(function() waiting = true btn.Text = "Nhấn phím..." end)
        UserInputService.InputBegan:Connect(function(i, gp)
          if waiting and i.UserInputType == Enum.UserInputType.Keyboard and not gp then key = i.KeyCode waiting = false btn.Text = key.Name if cfg.Callback then cfg.Callback(key) end end
        end)
        self:Grow(48)
      end
      return sec
    end
    return tab
  end

  -- ===== TAB CÀI ĐẶT SIÊU ĐẦY ĐỦ, CÓ SẴN TRONG UI =====
  local function BuildFullSettings()
    local SetTab = Window:CreateTab("Cài đặt", ICONS.Settings)
    local Sec1 = SetTab:CreateSection("Giao diện")
    Sec1:AddDropdown({Name = "Chủ đề", Options = {"Thanh", "Violet", "Ember", "Mint", "Hong"}, Callback = function(v) if THEMES[v] then ApplyTheme(THEMES[v], v) Window:Notify("THANH", "Đã đổi chủ đề: " .. v, 2) end end})
    Sec1:AddSlider({Name = "Độ trong suốt", Min = 0, Max = 60, Default = 8, Callback = function(v) Window.Config.Transparency = v Surface.BackgroundTransparency = v / 100 Sidebar.BackgroundTransparency = 0.25 + v / 200 MaybeSave() end})
    Sec1:AddSlider({Name = "Độ bo góc", Min = 0, Max = 24, Default = 16, Callback = function(v) Window.Config.Corner = v SurfaceCorner.CornerRadius = UDim.new(0, v) ContentCorner.CornerRadius = UDim.new(0, v) MaybeSave() end})
    Sec1:AddDropdown({Name = "Ngôn ngữ", Options = {"Tiếng Việt", "English"}, Callback = function(v) Window.Config.Language = v MaybeSave() Window:Notify("THANH", "Ngôn ngữ: " .. v, 2) end})

    local Sec2 = SetTab:CreateSection("Hiệu ứng")
    Sec2:AddToggle({Name = "Thiên thạch rơi", Desc = "Bật / tắt thiên thạch", Default = true, Callback = function(v) Window.Config.Meteor = v MeteorLayer.Visible = v MaybeSave() end})
    Sec2:AddToggle({Name = "Hạt nổi", Desc = "Bật / tắt hạt nổi bay", Default = true, Callback = function(v) Window.Config.Particles = v ParticleLayer.Visible = v MaybeSave() end})
    Sec2:AddToggle({Name = "Tia sáng quét", Desc = "Bật / tắt tia sáng header", Default = true, Callback = function(v) Window.Config.Shine = v HeaderShine.Visible = v MaybeSave() end})
    Sec2:AddToggle({Name = "Viền chuyển động", Desc = "Bật / tắt viền beam", Default = true, Callback = function(v) Window.Config.Beam = v BeamGroup.Visible = v MaybeSave() end})
    Sec2:AddToggle({Name = "Làm mờ nền", Desc = "Bật / tắt Blur", Default = true, Callback = function(v) Window.Config.Blur = v Blur.Enabled = v MaybeSave() end})
    Sec2:AddSlider({Name = "Tốc độ hiệu ứng", Min = 50, Max = 250, Default = 100, Callback = function(v) Window.Config.EffectSpeed = v EffectSpeed = v / 100 MaybeSave() end})
    Sec2:AddSlider({Name = "Mật độ thiên thạch", Min = 10, Max = 200, Default = 100, Callback = function(v) Window.Config.MeteorDensity = v MeteorDensity = v / 100 MaybeSave() end})

    local Sec3 = SetTab:CreateSection("Điều khiển")
    Sec3:AddKeybind({Name = "Phím mở / đóng UI", Default = Enum.KeyCode.RightShift, Callback = function(k) Window.Config.Keybind = k.Name opts.Keybind = k Window:Notify("THANH", "Phím mới: " .. k.Name, 2) MaybeSave() end})
    Sec3:AddToggle({Name = "Thông báo", Desc = "Bật / tắt thông báo", Default = true, Callback = function(v) Window.Config.Notifications = v Window.NotificationsEnabled = v MaybeSave() end})
    Sec3:AddToggle({Name = "Tự động lưu cấu hình", Desc = "Lưu ngay khi đổi cài đặt", Default = true, Callback = function(v) Window.Config.AutoSave = v MaybeSave() end})
    Sec3:AddButton({Name = "Đặt lại vị trí Launcher", Callback = function() if Launcher then Launcher.Position = UDim2.fromOffset(20, 20) end Window:Notify("THANH", "Đã đặt lại vị trí Launcher", 2) end})

    local Sec4 = SetTab:CreateSection("Hệ thống")
    Sec4:AddLabel("Phiên bản: THANH UI v2.0 | Tác giả: Thanh")
    local fpsObj = Sec4:AddLabel("FPS: ... | Ping: ... | Thời gian chạy: 0s")
    FpsLabel = fpsObj
    Sec4:AddButton({Name = "Chế độ gọn / Đầy đủ", Callback = function() Window.Compact = not Window.Compact if Window.Compact then ApplySize(520, 360) else ApplySize(720, 470) end end})
    Sec4:AddButton({Name = "Lưu cấu hình ngay", Callback = function() SaveConfig() end})
    Sec4:AddButton({Name = "Đặt lại mặc định", Callback = function() ApplyTheme(THEMES.Thanh, "Thanh") Surface.BackgroundTransparency = 0.08 EffectSpeed = 1 MeteorDensity = 1 MeteorLayer.Visible = true ParticleLayer.Visible = true HeaderShine.Visible = true BeamGroup.Visible = true Blur.Enabled = true ApplySize(720, 470) Window:Notify("THANH", "Đã đặt lại mặc định!", 2) end})
    Sec4:AddButton({Name = "Đóng UI", Callback = function() Window:SetOpen(false) end})
  end

  local NotifHolder = New("Frame", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(320, 600), BackgroundTransparency = 1, ZIndex = 250}, Gui)
  function Window:Notify(title, msg, dur)
    if not Window.NotificationsEnabled then return end
    local n = New("Frame", {Position = UDim2.fromOffset(340, 0), Size = UDim2.fromOffset(320, 76), BackgroundColor3 = T.Card, BackgroundTransparency = 0.05, BorderSizePixel = 0, ClipsDescendants = true}, NotifHolder)
    Corner(n, 10) Stroke(n, T.Accent, 2, 0)
    New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -28, 0, 24), Font = Enum.Font.GothamBold, TextSize = 13, Text = title, TextColor3 = T.Text, TextXAlignment = Enum.TextXAlignment.Left}, n)
    New("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 32), Size = UDim2.new(1, -28, 0, 36), Font = Enum.Font.Gotham, TextSize = 11, Text = msg, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true}, n)
    Tween(n, {Position = UDim2.fromOffset(0, 0)}, 0.3)
    task.delay(dur or 3, function() Tween(n, {Position = UDim2.fromOffset(340, 0)}, 0.3) task.wait(0.35) n:Destroy() end)
  end

  local Launcher = New("ImageButton", {Name = "Launcher", Position = UDim2.fromOffset(20, 20), Size = UDim2.fromOffset(54, 54), BackgroundColor3 = Color3.fromRGB(4, 10, 28), BorderSizePixel = 0, AutoButtonColor = false, Visible = false, ZIndex = 50}, Gui)
  Corner(Launcher, 999)
  local lStroke = Stroke(Launcher, T.Accent, 3, 0)
  local lGrad = New("UIGradient", {Rotation = 0}, lStroke)
  MakeIcon(Launcher, ICONS.Logo, 12, 12, 30, T.Accent, 51)

  function Window:SetOpen(v)
    Window.Open = v Root.Visible = v Launcher.Visible = not v
    Tween(Blur, {Size = v and 18 or 0}, 0.25)
    if v then Tween(Content, {Size = UDim2.fromOffset(curW, curH)}, 0.25) end
  end

  -- 3 nút trên header: Cài đặt | Ẩn | Đóng, Cài đặt nằm ngay cạnh nút Ẩn
  settingsBtn = TopBtn(WW - 132, ICONS.Settings, function()
    local setTab = Window.Tabs["Cài đặt"]
    if setTab then SelectTab(setTab) end
  end)
  minBtn = TopBtn(WW - 88, ICONS.Minimize, function() Window:SetOpen(false) end)
  closeBtn = TopBtn(WW - 44, ICONS.Close, function() Window:SetOpen(false) end)
  ApplySize(curW, curH)
  Launcher.Activated:Connect(function() Window:SetOpen(true) end)

  local dragging, dragStart, startPos
  Drag.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = i dragStart = Vector2.new(i.Position.X, i.Position.Y) startPos = Vector2.new(Root.Position.X.Offset, Root.Position.Y.Offset) end end)
  UserInputService.InputChanged:Connect(function(i) if dragging and i == dragging then local d = Vector2.new(i.Position.X, i.Position.Y) - dragStart Root.Position = UDim2.fromOffset(startPos.X + d.X, startPos.Y + d.Y) end end)
  UserInputService.InputEnded:Connect(function(i) if i == dragging then dragging = nil end end)
  local lDrag, lStart, lPos
  Launcher.InputBegan:Connect(function(i) lDrag = i lStart = Vector2.new(i.Position.X, i.Position.Y) lPos = Vector2.new(Launcher.Position.X.Offset, Launcher.Position.Y.Offset) end)
  UserInputService.InputChanged:Connect(function(i) if lDrag and i == lDrag then local d = Vector2.new(i.Position.X, i.Position.Y) - lStart Launcher.Position = UDim2.fromOffset(math.clamp(lPos.X + d.X, 0, 1200), math.clamp(lPos.Y + d.Y, 0, 700)) end end)
  UserInputService.InputEnded:Connect(function(i) if i == lDrag then lDrag = nil end end)
  UserInputService.InputBegan:Connect(function(i, gp) if not gp and i.KeyCode == (opts.Keybind or Enum.KeyCode.RightShift) then Window:SetOpen(not Window.Open) end end)

  -- Tự tạo sẵn tab Cài đặt, không cần gọi thêm
  BuildFullSettings()

  local t = 0 local fpsAcc, fpsCount, fpsVal = 0, 0, 60
  RunService.RenderStepped:Connect(function(dt)
    if not Gui.Parent then return end
    t += math.min(dt, 0.05) * EffectSpeed
    fpsAcc += dt fpsCount += 1
    if fpsAcc >= 0.5 then fpsVal = math.floor(fpsCount / fpsAcc + 0.5) fpsAcc = 0 fpsCount = 0
      if FpsLabel then local ping = 0 pcall(function() ping = math.floor(Players.LocalPlayer:GetNetworkPing() * 1000) end) FpsLabel:Set("FPS: " .. fpsVal .. " | Ping: " .. ping .. "ms | Thời gian chạy: " .. math.floor(tick() - StartTime) .. "s") end
    end
    for i, g in ipairs(BeamGrads) do g.Rotation = (t * 90 + i * 40) % 360 end
    lGrad.Rotation = (t * 120) % 360
    for _, p in ipairs(Dots) do
      p.x = (p.x + p.sx * dt) % 1 p.y = (p.y + p.sy * dt) % 1
      if p.x < 0 then p.x = 1 end if p.y < 0 then p.y = 1 end
      p.obj.Position = UDim2.fromScale(p.x, p.y)
      local s = p.base + math.sin(t * 2 + p.ph) * 1.2
      p.obj.Size = UDim2.fromOffset(s, s)
    end
  end)

  task.delay(0.05, function() for _, tab in pairs(Window.Tabs) do SelectTab(tab) break end end)
  return Window
end

return Thanh
