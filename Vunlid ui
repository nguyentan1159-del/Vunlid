		if waiting then return end
		waiting = true
		btn.Text = "..."
		local conn
		conn = UserInputService.InputBegan:Connect(function(input, gp)
			if gp then return end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				curKey = input.KeyCode
				btn.Text = curKey.Name
				waiting = false
				conn:Disconnect()
				if config.Callback then pcall(config.Callback, curKey) end
			end
		end)
	end)

	-- Bấm phím sẽ chạy callback OnPress nếu có
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == curKey and not waiting and config.OnPress then pcall(config.OnPress) end
	end)

	local api = {}
	function api:Get() return curKey end
	function api:Set(k) curKey = k btn.Text = k.Name end
	return api
end

