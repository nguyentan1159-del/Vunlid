	lbl.BackgroundTransparency = 1
	lbl.Size = UDim2.new(1, -50, 1, 0)
	lbl.Parent = top
	local valLbl = Instance.new("TextLabel")
	valLbl.Text = tostring(val)
	valLbl.Font = Enum.Font.GothamBold
	valLbl.TextSize = 13
	valLbl.TextColor3 = self.Theme.Accent2
	valLbl.TextXAlignment = Enum.TextXAlignment.Right
	valLbl.BackgroundColor3 = self.Theme.Background
	valLbl.Size = UDim2.new(0, 44, 0, 20)
	valLbl.Position = UDim2.new(1, -44, 0, 0)
	valLbl.Parent = top
	Corner(valLbl, 6)

	local track = Instance.new("Frame")
	track.Size = UDim2.new(1, 0, 0, 8)
	track.Position = UDim2.new(0, 0, 0, 30)
	track.BackgroundColor3 = Color3.fromRGB(45,45,65)
	track.Parent = base
	Corner(track, 4)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = self.Theme.Accent
	fill.Parent = track
	Corner(fill, 4)
	local fgrad = Instance.new("UIGradient")
	fgrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, self.Theme.Accent),
		ColorSequenceKeypoint.new(1, self.Theme.Accent2),
	})
	fgrad.Parent = fill

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 16, 0, 16)
	knob.Position = UDim2.new((val - min) / (max - min), -8, 0.5, -8)
	knob.BackgroundColor3 = Color3.fromRGB(255,255,255)
	knob.ZIndex = 3
	knob.Parent = track
	Corner(knob, 100)
	Stroke(knob, self.Theme.Accent, 2)

	local dragging = false
	local function SetFromPos(x)
		local pct = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		val = math.floor(min + (max - min) * pct + 0.5)
		if config.Increment then val = math.floor(val / config.Increment) * config.Increment end
		valLbl.Text = tostring(val)
		Tween(fill, {Size = UDim2.new(pct, 0, 1, 0)}, 0.08)
		Tween(knob, {Position = UDim2.new(pct, -8, 0.5, -8)}, 0.08)
		if config.Callback then pcall(config.Callback, val) end
	end
	track.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true SetFromPos(i.Position.X) end
	end)
	UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
	UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then SetFromPos(i.Position.X) end
	end)

	local api = {}
	function api:Set(v) val = math.clamp(v, min, max) local pct = (val-min)/(max-min) valLbl.Text = tostring(val) fill.Size = UDim2.new(pct,0,1,0) knob.Position = UDim2.new(pct,-8,0.5,-8) if config.Callback then pcall(config.Callback, val) end end
	function api:Get() return val end
	return api
end

function LunUI.ElementMethods:AddDropdown(config)
	config = config or {}
	local options = config.Options or {"Option 1", "Option 2"}
	local multi = config.Multi or false
	local selected = {}
	if config.Default then
		if type(config.Default) == "table" then selected = config.Default else selected = {config.Default} end
	end
	local open = false
	local base = self._Base(42)
	base.AutomaticSize = Enum.AutomaticSize.Y

	local lbl = Instance.new("TextLabel")
	lbl.Text = config.Name or "Dropdown"
